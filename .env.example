# Copy to .env and fill real values (never commit .env)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Netlify: set NUXT_DATABASE_URL + NUXT_SESSION_PASSWORD (NUXT_ prefix = Nitro runtime, not inlined at build)
# Local:  DATABASE_URL / NUXT_SESSION_PASSWORD both work (see server/db/index.ts + server/lib/auth.ts)
NUXT_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
NUXT_SESSION_PASSWORD= # openssl rand -base64 32 (min 32 chars)
STITCH_API_KEY= # per-dev GCP key — opencode.json:7 uses ${STITCH_API_KEY}
