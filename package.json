{
  "name": "nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "BASE_URL=http://localhost:3000 node scripts/smoke.mjs",
    "test:smoke": "pnpm build && (pnpm dev --port 3000 --host 127.0.0.1 &); sleep 8; node scripts/smoke.mjs; kill %1 || true"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.70",
    "@nuxt/icon": "^2.2.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nuxt": "4.6.1",
    "tailwindcss": "^4.0.16",
    "vue": "^3.5.28",
    "vue-router": "^5.0.0"
  },
  "dependencies": {
    "@casl/ability": "^7.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxt/image": "^2.0.0",
    "@tailwindcss/vite": "^4.0.16",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "nuxt-auth-utils": "^0.5.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  }
}
